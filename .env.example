# ==========================================
# School Helpdesk AI - Environment Variables
# ==========================================

# API Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_helpdesk
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_helpdesk?schema=public"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=1d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=20971520 # 20 MB

# LLM & Embedding Settings
# Provider options: openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Guardrail & Rate Limiting Defaults
SIMILARITY_THRESHOLD=0.65
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=30
TENANT_DAILY_TOKEN_LIMIT=100000

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
